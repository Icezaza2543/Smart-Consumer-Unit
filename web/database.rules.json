{
  "rules": {
    ".read": "auth.uid === 'YOUR_OPERATOR_UID'",
    ".write": "auth.uid === 'YOUR_OPERATOR_UID'",
    "board1": {
      "outputs": {
        "digital": {
          "$gpio": {
            ".validate": "($gpio === '2' || $gpio === '4' || $gpio === '5' || $gpio === '21' || $gpio === '14' || $gpio === '15' || $gpio === '16' || $gpio === '17') && (newData.val() === 0 || newData.val() === 1)"
          }
        }
      },
      "charts": {
        "range": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && newData.val() % 1 === 0"
        }
      }
    }
  }
}
